#!/bin/bash -eux

unset GOROOT GOPATH
export PATH="/sbin:/usr/sbin:/usr/local/bin:/usr/bin:/bin:/usr/local/games:/usr/games"

# Go version: local override below, else ~/.config/go-version, else 1.26
go_version=""
if [ -z "${go_version}" ] && [ -r "${HOME}/.config/go-version" ]
then
  go_version="$(cat "${HOME}/.config/go-version")"
fi
[ -z "${go_version}" ] && go_version="1.26"
if [ ! -x "/usr/lib/go-${go_version}/bin/go" ]
then
  echo "build-k8s: no Go toolchain at /usr/lib/go-${go_version}" >&2
  exit 1
fi
export PATH="/usr/lib/go-${go_version}/bin:$PATH"
unset go_version

version="${1:-}"
builduser="${K8S_BUILDUSER:-$USER}"
self="$(readlink -f "$0")"

if [ "$(id -u "$builduser")" != "$UID" ]
then
  exec sudo -H -u "$builduser" "$self"
fi

srcdir="/opt/kubernetes/src/kubernetes"
cd "${srcdir}"

if [ -d "${srcdir}/_output" ]
then
  chmod u+w -R  "${srcdir}/_output"
fi

if [ -n "${version}" ]
then
  git fetch -a
  git clean -dfx
  git checkout "${version}"
fi

destdir="/opt/kubernetes/bin"
mkdir -p "${destdir}"

cd "${srcdir}"
declare -a go cmds

export KUBE_ROOT="${srcdir}"
export KUBE_GO_PACKAGE=""
export CGO_ENABLED=0

# shellcheck disable=SC1090
source "${srcdir}/hack/lib/version.sh"

go=(go build -gcflags=-trimpath=${srcdir} -v -mod=vendor "-tags=providerless,dockerless" -ldflags "$(kube::version::ldflags|sed 's^/vendor/^^g')" )

cmds=(
  kube-apiserver
  kube-controller-manager
  kube-scheduler
  kube-proxy
  kubelet
  kubectl
  kubeadm
  cloud-controller-manager
)

for d in "${cmds[@]}"
do
  "${go[@]}" -o "${destdir}/${d}" "./cmd/${d}"
  strip "${destdir}/${d}"
done
