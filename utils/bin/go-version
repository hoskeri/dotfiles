#!/bin/sh
# go-version - resolve which Go toolchain version to use.
#
# Resolution order (first hit wins):
#   1. $GO_VERSION            - explicit override, e.g. GO_VERSION=1.25 build-k8s
#   2. ./.go-version          - a version file in the current directory or any
#                               parent (asdf/mise style). Pin a project by
#                               committing a .go-version file to its root.
#   3. ~/.config/go-version   - the machine default (see config/ in dotfiles).
#
# The version is the bare directory suffix used by the system Go packages,
# e.g. "1.26" for /usr/lib/go-1.26. The first line of the file is used.
#
# Prints the resolved version to stdout (nothing if it cannot be resolved).
# Always exits 0; callers decide how to handle an empty result.

version="${GO_VERSION:-}"

if [ -z "${version}" ]
then
  d="${PWD}"
  while :
  do
    if [ -f "${d}/.go-version" ]
    then
      version="$(sed -n '1p' "${d}/.go-version")"
      break
    fi
    [ "${d}" = "/" ] && break
    d="$(dirname "${d}")"
  done
fi

if [ -z "${version}" ]
then
  config="${XDG_CONFIG_HOME:-${HOME}/.config}/go-version"
  [ -f "${config}" ] && version="$(sed -n '1p' "${config}")"
fi

if [ -n "${version}" ]
then
  printf '%s\n' "${version}"
fi